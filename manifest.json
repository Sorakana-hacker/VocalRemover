{
  "name": "Wakapippi Vocal Remover Extension",
  "description": "AIが再生中のWeb動画からリアルタイムでボーカルを除去。ボーカルと伴奏のミックスも自由自在。すべてブラウザ内で処理されます。",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "page": "background_safari.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vocal-remover-processor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
