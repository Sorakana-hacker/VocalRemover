{
  "name": "Wakapippi Vocal Remover Extension",
  "description": "AI?????Web?????????????????????????????????????????????????????",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "page": "background_safari.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vocal-remover-processor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
